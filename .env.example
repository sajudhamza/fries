# Public base URL used inside QR codes. Leave unset locally to use the request host
# (use your LAN IP, e.g. http://192.168.1.20:3000, if you want to scan with a phone).
# NEXT_PUBLIC_APP_URL=https://fries.example.com

# Signs admin + attendee session cookies. Use a long random value in every environment.
SESSION_SECRET=change-me

# Password for the /admin console.
ADMIN_PASSWORD=change-me

# Bearer token for GET /api/cron/purge (call it every few minutes from a scheduler).
CRON_SECRET=change-me

# Persistence. Unset = local JSON file in .data/ (dev only).
# Set to the Supabase transaction pooler URL (port 6543) and run supabase/migrations/*.sql.
# DATABASE_URL=postgres://...

# Video storage. Unset = local disk in .data/videos (dev only).
# Set both to store intro videos in a PRIVATE Supabase Storage bucket (browser uploads directly via signed URL).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_VIDEO_BUCKET=intro-videos

# Video → profile extraction. Both optional: without them attendees fill in their profile by hand.
# Speech-to-text of the intro video (https://console.deepgram.com).
# DEEPGRAM_API_KEY=...
# Claude reads the transcript and fills in the profile fields (https://console.anthropic.com).
# ANTHROPIC_API_KEY=...
